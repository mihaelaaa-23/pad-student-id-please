// Grafana Alloy: ships the stdout of every container of this compose project to Loki
// (Lab 4, grade 4). It reads the logs through the Docker API on the socket, mounted
// read-only into this container only; no service changes, and the Gateway never sees
// the socket. Reading through the API rather than /var/lib/docker/containers also works
// on Docker Desktop (macOS, Windows), where those files are not on the host.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "compose" {
  targets = discovery.docker.containers.targets

  // Only containers started by compose; anything else on the Docker host is skipped.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = ".+"
    action        = "keep"
  }

  // Not Loki's or Alloy's own output: Loki logs every push it receives, so shipping it
  // back to Loki would feed on itself and drown the services' lines.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "loki|alloy"
    action        = "drop"
  }

  // `service` is the compose service name, so both replicas of a service share it;
  // `container` tells them apart.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.compose.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
