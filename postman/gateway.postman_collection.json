          }
        },
        {
          "name": "Cache - Auth Metrics After",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "function authHits(text) {",
                  "  const m = text.match(/^cache_requests_total\\{kind=\"auth\",result=\"hit\"\\} (\\d+)$/m);",
                  "  return m ? Number(m[1]) : 0;",
                  "}",
                  "pm.test('the player token was answered from the auth cache', function () {",
                  "  pm.expect(authHits(pm.response.text())).to.be.above(Number(pm.collectionVariables.get('authHitsBefore')));",
                  "});"
