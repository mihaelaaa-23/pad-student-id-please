    {
      "name": "Cache Ring (Lab 5)",
      "description": "Lab 5, grade 7: GET /cache/ring and /cache/ring/lookup, service token only.",
      "item": [
        {
          "name": "Cache Ring - Three Nodes Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "const ring = pm.response.json();",
                  "pm.test('160 virtual nodes per node', function () { pm.expect(ring.vnodes).to.eql(160); });",
                  "pm.test('cache-1, cache-2 and cache-3, all up', function () {",
                  "  pm.expect(ring.nodes.map(function (n) { return n.node; }).sort()).to.eql(['cache-1', 'cache-2', 'cache-3']);",
                  "  ring.nodes.forEach(function (n) { pm.expect(n.state).to.eql('up'); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/cache/ring",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
