{
  "info": {
    "_postman_id": "b1e1b2b0-3333-4a1a-9c1a-gateway00001",
    "name": "Gateway - Log Download and Cache",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Lab 4, grade 4: GET /logs/download on the Gateway. Lab 5, grades 6 and 7: the response cache, the auth cache and the cache ring. Run with the service token:\nnpx newman run postman/gateway.postman_collection.json --env-var serviceToken=$SERVICE_TOKEN"
