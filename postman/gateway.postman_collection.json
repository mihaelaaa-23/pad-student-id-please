        },
        {
          "name": "Cache - Player Read Again Is HIT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('X-Cache is HIT', function () { pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cache-Control",
                "value": "max-age=60"
              }
            ],
            "url": "{{gatewayUrl}}/applicant/applicants/{{cacheApplicantId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
