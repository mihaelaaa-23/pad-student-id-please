    {
      "name": "Cache (Lab 5)",
      "description": "Lab 5, grade 6: response cache (MISS, HIT, caller scope, invalidation by version after PATCH, Cache-Control: no-cache) and the auth cache (cache_requests_total{kind=\"auth\",result=\"hit\"} grows). Assumes one Gateway instance, as in compose. Postman sends Cache-Control: no-cache by default (Settings > Send no-cache header), which the Gateway answers with BYPASS; the reads that should use the cache set Cache-Control: max-age=60 themselves.",
      "item": [
        {
          "name": "Cache - Create Applicant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('applicant created', function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set('cacheApplicantId', pm.response.json().applicantId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/applicant/applicants",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cache Demo\",\n  \"studentId\": \"FCIM-239901\",\n  \"major\": \"Software Engineering\",\n  \"year\": 3,\n  \"role\": \"student_faf\",\n  \"status\": \"active\"\n}"
            }
          }
        },
        {
          "name": "Cache - First Read Is MISS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('X-Cache is MISS', function () { pm.expect(pm.response.headers.get('X-Cache')).to.eql('MISS'); });",
                  "pm.test('X-Cache-Node names a cache node', function () { pm.expect(pm.response.headers.get('X-Cache-Node')).to.match(/^cache-[1-3]$/); });",
                  "pm.collectionVariables.set('cacheNode', pm.response.headers.get('X-Cache-Node'));",
                  "pm.collectionVariables.set('cacheBody', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cache-Control",
                "value": "max-age=60"
              }
            ],
            "url": "{{gatewayUrl}}/applicant/applicants/{{cacheApplicantId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cache - Second Read Is HIT",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('X-Cache is HIT', function () { pm.expect(pm.response.headers.get('X-Cache')).to.eql('HIT'); });",
                  "pm.test('served by the same node, the ring sends a key to one node', function () {",
                  "  pm.expect(pm.response.headers.get('X-Cache-Node')).to.eql(pm.collectionVariables.get('cacheNode'));",
                  "});",
                  "pm.test('same body as the first read', function () {",
                  "  pm.expect(pm.response.json()).to.eql(JSON.parse(pm.collectionVariables.get('cacheBody')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cache-Control",
                "value": "max-age=60"
              }
            ],
            "url": "{{gatewayUrl}}/applicant/applicants/{{cacheApplicantId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Cache - Auth Metrics Before",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "function authHits(text) {",
                  "  const m = text.match(/^cache_requests_total\\{kind=\"auth\",result=\"hit\"\\} (\\d+)$/m);",
                  "  return m ? Number(m[1]) : 0;",
                  "}",
                  "pm.collectionVariables.set('authHitsBefore', String(authHits(pm.response.text())));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gatewayUrl}}/metrics",
