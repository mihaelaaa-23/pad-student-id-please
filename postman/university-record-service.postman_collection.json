{
  "info": {
    "_postman_id": "c4b9a7d2-6e41-4f83-b2d7-university-record001",
    "name": "University Record Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3006"
    },
    {
      "key": "applicantId",
      "value": "applicant-001"
    },
    {
      "key": "requestingPlayerId",
      "value": "player-001"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('reports ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });",
              "pm.test('database is up', function () { pm.expect(pm.response.json().database).to.eql('up'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "List University Records",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns an array', function () { pm.expect(json).to.be.an('array'); });",
              "pm.test('contains seeded records', function () { pm.expect(json.length).to.be.at.least(2); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/records",
          "host": ["{{baseUrl}}"],
          "path": ["records"]
        }
      }
    },
    {
      "name": "Get Record - Missing Requesting Player",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 422', function () { pm.response.to.have.status(422); });",
              "pm.test('returns validation error', function () { pm.expect(json.error.code).to.eql('VALIDATION_FAILED'); });",
              "pm.test('requires requestingPlayerId', function () { pm.expect(json.error.message).to.eql('requestingPlayerId query parameter is required');});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/records/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["records", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Get Record",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns the requested applicant record', function () { pm.expect(json.applicant_id).to.eql(pm.collectionVariables.get('applicantId')); });",
              "pm.test('contains fields object', function () {pm.expect(json.fields).to.be.an('object');});",
              "pm.test('contains name', function () {pm.expect(json.fields.name).to.be.a('string').and.not.empty;});",
              "pm.test('contains studentId', function () {pm.expect(json.fields.studentId).to.be.a('string').and.not.empty;});",
              "pm.test('contains university', function () {pm.expect(json.fields.university).to.be.a('string').and.not.empty;});",
              "pm.test('contains faculty', function () { pm.expect(json.fields.faculty).to.be.a('string').and.not.empty;});",
              "pm.test('contains role', function () { pm.expect(json.fields.role).to.be.a('string').and.not.empty;});",
              "pm.test('contains status', function () { pm.expect(json.fields.status).to.be.a('string').and.not.empty;});",
              "pm.test('contains studyYear', function () { pm.expect(json.fields.studyYear).to.be.a('number');});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/records/{{applicantId}}?requestingPlayerId={{requestingPlayerId}}",
          "host": ["{{baseUrl}}"],
          "path": ["records", "{{applicantId}}"],
          "query": [
            {
              "key": "requestingPlayerId",
              "value": "{{requestingPlayerId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Get Record - Unknown Applicant",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 404', function () {pm.response.to.have.status(404);});",
              "pm.test('returns not found error', function () { pm.expect(json.error.code).to.eql('NOT_FOUND');});",
              "pm.test('reports record not found', function () {pm.expect(json.error.message).to.eql('University record not found');});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/records/does-not-exist?requestingPlayerId={{requestingPlayerId}}",
          "host": ["{{baseUrl}}"],
          "path": ["records", "does-not-exist"],
          "query": [
            {
              "key": "requestingPlayerId",
              "value": "{{requestingPlayerId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Create University Record",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('returns the submitted applicant', function () { pm.expect(json.applicant_id).to.eql('postman-applicant-001'); });",
              "pm.test('returns the university', function () { pm.expect(json.university).to.eql('Technical University of Moldova'); });",
              "pm.collectionVariables.set('createdApplicantId', 'postman-applicant-001');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicantId\": \"postman-applicant-001\",\n  \"studentId\": \"UTM-POSTMAN-001\",\n  \"name\": \"Postman Applicant\",\n  \"role\": \"student_faf\",\n  \"university\": \"Technical University of Moldova\",\n  \"faculty\": \"Faculty of Computers, Informatics and Microelectronics\",\n  \"program\": \"Software Engineering\",\n  \"studyYear\": 4,\n  \"status\": \"active\",\n  \"averageGrade\": 9.50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/records",
          "host": ["{{baseUrl}}"],
          "path": ["records"]
        }
      }
    },
