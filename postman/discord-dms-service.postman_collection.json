{
  "info": {
    "_postman_id": "6f2a1d58-7f1c-4c2e-9b74-1c1c8b0d1a01",
    "name": "Discord DMs Service",
    "description": "Every HTTP endpoint of the Discord DMs Service (Team 18, PAD project \"Student ID, Please\"), ordered as a walkthrough of one moderation shift: create the channels, put the team on them, talk, then clean up.\n\nRun it top to bottom with the Collection Runner against a running stack (`./scripts/run.sh`, or `docker compose up -d`). Each request asserts its own status code, and the message id is passed between requests through a collection variable.\n\nThe real-time endpoint is not part of this collection, because a WebSocket cannot be replayed by the Collection Runner. Open it separately, in Postman's WebSocket request type or with `websocat`:\n\n    ws://localhost:8080/ws/sessions/{{sessionId}}/channels/general-mod-chat?playerId={{juniorId}}\n\nSend `{\"senderId\": \"{{juniorId}}\", \"content\": \"Hello\"}` and every other client on that channel receives `{\"senderId\", \"content\", \"timestamp\"}`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "sessionId", "value": "shift-001" },
    { "key": "moderatorId", "value": "player-moderator-1" },
    { "key": "juniorId", "value": "player-junior-1" },
    { "key": "messageId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get service status",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/status", "host": ["{{baseUrl}}"], "path": ["status"] },
            "description": "Reports whether the service is up and whether it can reach MongoDB."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the service is up', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('the database is reachable', function () {",
                  "    pm.expect(pm.response.json().database).to.eql('up');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Channels",
      "item": [
        {
          "name": "Create the default channels of a shift",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/bootstrap",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "bootstrap"]
            },
            "description": "Creates #enrollment-check, #faculty-check, #course-registration and #general-mod-chat. Safe to run twice: channels that already exist are reported as existing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the session has its four channels', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().channels).to.have.lengthOf(4);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create an extra channel",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"name\": \"impersonation-watch\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the channel was created', function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.expect(pm.response.json().name).to.eql('impersonation-watch');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a channel with an invalid name",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"name\": \"General Mod Chat\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels"]
            },
            "description": "Channel names follow Discord conventions, so a name with spaces and capitals is rejected with an explanation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the name is rejected with an explanation', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.include('lowercase');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List every channel of the shift",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('all five channels are listed', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().channels).to.include('impersonation-watch');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one channel",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels/general-mod-chat",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels", "general-mod-chat"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the channel is returned with its id', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rename a channel",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n    \"name\": \"impersonation-check\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels/impersonation-watch",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels", "impersonation-watch"]
            },
            "description": "The channel keeps its id and its messages, and every assignment to it follows the new name."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the channel was renamed', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().name).to.eql('impersonation-check');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Members",
      "item": [
        {
          "name": "Put the moderator on the shift",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"playerId\": \"{{moderatorId}}\",\n    \"role\": \"moderator\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "members"]
            },
            "description": "The moderator running the shift reaches every channel, so no channel list is needed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the moderator joined', function () {",
