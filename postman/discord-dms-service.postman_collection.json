                  "    pm.expect(pm.response.json().role).to.eql('moderator');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Put a junior moderator on two channels",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"playerId\": \"{{juniorId}}\",\n    \"role\": \"junior\",\n    \"channels\": [\"enrollment-check\", \"general-mod-chat\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "members"]
            },
            "description": "Information is fragmented on purpose: this player sees only the two channels they were assigned."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the junior moderator was assigned two channels', function () {",
                  "    pm.response.to.have.status(200);",
