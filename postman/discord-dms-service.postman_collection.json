                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one member",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/members/{{juniorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "members", "{{juniorId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the member is returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().playerId).to.eql(pm.collectionVariables.get('juniorId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List the channels one player can see",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels?playerId={{juniorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels"],
              "query": [{ "key": "playerId", "value": "{{juniorId}}" }]
            },
            "description": "This is the endpoint from the team communication contract: the channels visible to the requesting player."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('only the assigned channels are visible', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const channels = pm.response.json().channels;",
                  "    pm.expect(channels).to.have.lengthOf(2);",
                  "    pm.expect(channels).to.not.include('faculty-check');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Post a message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"senderId\": \"{{juniorId}}\",\n    \"content\": \"The enrollment list has no student with this id.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels/general-mod-chat/messages",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels", "general-mod-chat", "messages"]
            },
            "description": "The message is stored and pushed to everyone who has this channel open over WebSocket."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the message was posted', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('messageId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Post to a channel the player was not assigned",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"senderId\": \"{{juniorId}}\",\n    \"content\": \"Can I read this one too?\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels/faculty-check/messages",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels", "faculty-check", "messages"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the player is kept out of that channel', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the channel history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels/general-mod-chat/messages?playerId={{moderatorId}}&limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels", "general-mod-chat", "messages"],
              "query": [
                { "key": "playerId", "value": "{{moderatorId}}" },
                { "key": "limit", "value": "50" },
                { "key": "before", "value": "2026-09-20T18:30:00Z", "disabled": true }
              ]
            },
            "description": "Returns the latest messages in chronological order. Enable 'before' to page further back."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the history contains the message', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().count).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one message",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels/general-mod-chat/messages/{{messageId}}?playerId={{moderatorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels", "general-mod-chat", "messages", "{{messageId}}"],
              "query": [{ "key": "playerId", "value": "{{moderatorId}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the message is returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('messageId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit a message",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"senderId\": \"{{juniorId}}\",\n    \"content\": \"Correction: the id is on the list, but under another name.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels/general-mod-chat/messages/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels", "general-mod-chat", "messages", "{{messageId}}"]
            },
            "description": "Only the author may rewrite what they said."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the message was edited', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().editedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Edit someone else's message",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"senderId\": \"{{moderatorId}}\",\n    \"content\": \"Rewriting what a junior moderator said.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels/general-mod-chat/messages/{{messageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels", "general-mod-chat", "messages", "{{messageId}}"]
            },
            "description": "Even the moderator cannot put words in someone else's mouth; they may only delete."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('editing a message of another player is refused', function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete a message as the moderator",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/channels/general-mod-chat/messages/{{messageId}}?playerId={{moderatorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "channels", "general-mod-chat", "messages", "{{messageId}}"],
              "query": [{ "key": "playerId", "value": "{{moderatorId}}" }]
            },
            "description": "The author may delete their own message, and the moderator of the shift may delete anyone's."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the message is gone', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
