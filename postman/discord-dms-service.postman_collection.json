          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"playerId\": \"player-intruder\",\n    \"role\": \"admin\",\n    \"channels\": [\"faculty-check\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "members"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the role is rejected', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().error).to.include('moderator');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List the roster of the shift",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/{{sessionId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{sessionId}}", "members"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
