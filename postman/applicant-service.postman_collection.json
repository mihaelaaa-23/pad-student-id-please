{
  "info": {
    "_postman_id": "b1e1b2b0-3333-4a1a-9c1a-applicant001",
    "name": "Applicant Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3003" },
    { "key": "applicantId", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('reports ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Generate Applicant (seeded)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('returns the contract shape', function () {",
              "  pm.expect(json).to.have.all.keys('applicantId', 'name', 'studentId', 'major', 'year', 'role', 'status');",
              "});",
              "pm.test('does not expose ground truth', function () {",
              "  pm.expect(json).to.not.have.property('scenario');",
              "});",
              "pm.test('seeded generation is reproducible', function () {",
              "  pm.expect(json.name).to.eql('Dorin Chirtoaca');",
              "});",
              "pm.test('studentId follows the agreed format', function () {",
              "  pm.expect(json.studentId).to.match(/^FCIM-(X)?\\d{5,6}$/);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/applicants/generate?seed=42",
          "host": ["{{baseUrl}}"],
          "path": ["applicants", "generate"],
          "query": [{ "key": "seed", "value": "42" }]
        }
      }
    },
    {
      "name": "Create Applicant",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('echoes the submitted applicant', function () {",
              "  pm.expect(json.name).to.eql('Ana Rusu');",
              "  pm.expect(json.studentId).to.eql('FCIM-234411');",
              "  pm.expect(json.role).to.eql('student_faf');",
              "});",
              "pm.test('assigns an applicantId', function () { pm.expect(json.applicantId).to.be.a('string').and.not.empty; });",
              "if (json.applicantId) { pm.collectionVariables.set('applicantId', json.applicantId); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana Rusu\",\n  \"studentId\": \"FCIM-234411\",\n  \"major\": \"Robotics\",\n  \"year\": 2,\n  \"role\": \"student_faf\",\n  \"status\": \"active\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/applicants", "host": ["{{baseUrl}}"], "path": ["applicants"] }
      }
    },
    {
      "name": "Create Applicant - Invalid Role",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 422', function () { pm.response.to.have.status(422); });",
              "pm.test('uses the shared error shape', function () {",
              "  pm.expect(json.error.code).to.eql('VALIDATION_FAILED');",
              "  pm.expect(json.error.details).to.be.an('array').that.is.not.empty;",
              "});",
              "pm.test('names the offending field', function () {",
              "  const paths = json.error.details.map(function (d) { return d.path; });",
              "  pm.expect(paths).to.include('role');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Invalid Applicant\",\n  \"studentId\": \"FCIM-234412\",\n  \"major\": \"Robotics\",\n  \"year\": 2,\n  \"role\": \"wizard\",\n  \"status\": \"active\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/applicants", "host": ["{{baseUrl}}"], "path": ["applicants"] }
      }
    },
    {
      "name": "Get Applicant",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns the requested applicant', function () {",
              "  pm.expect(json.applicantId).to.eql(pm.collectionVariables.get('applicantId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/applicants/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["applicants", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Get Applicant - Unknown Id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('reports NOT_FOUND', function () { pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/applicants/does-not-exist",
          "host": ["{{baseUrl}}"],
          "path": ["applicants", "does-not-exist"]
        }
      }
    },
    {
      "name": "List Applicants By Role",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns a page', function () {",
              "  pm.expect(json.items).to.be.an('array');",
              "  pm.expect(json).to.have.property('nextCursor');",
              "});",
              "pm.test('every item matches the requested role', function () {",
              "  json.items.forEach(function (item) { pm.expect(item.role).to.eql('student_faf'); });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/applicants?role=student_faf&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["applicants"],
          "query": [
            { "key": "role", "value": "student_faf" },
            { "key": "limit", "value": "5" }
          ]
        }
      }
    },
    {
      "name": "Patch Applicant Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('applies the change', function () { pm.expect(json.status).to.eql('suspended'); });",
              "pm.test('leaves identity untouched', function () {",
              "  pm.expect(json.applicantId).to.eql(pm.collectionVariables.get('applicantId'));",
              "  pm.expect(json.studentId).to.eql('FCIM-234411');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"status\": \"suspended\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/applicants/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["applicants", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Patch Applicant - Immutable Field",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', function () { pm.response.to.have.status(422); });",
              "pm.test('refuses to change the shared key', function () {",
              "  pm.expect(pm.response.json().error.message).to.include('immutable');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"studentId\": \"FCIM-999999\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/applicants/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["applicants", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Delete Applicant",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('confirms the deletion', function () {",
              "  pm.expect(json.applicantId).to.eql(pm.collectionVariables.get('applicantId'));",
              "  pm.expect(json.deleted).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/applicants/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["applicants", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Delete Applicant - Already Deleted",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('reports NOT_FOUND', function () { pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/applicants/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["applicants", "{{applicantId}}"]
        }
      }
    }
  ]
}
