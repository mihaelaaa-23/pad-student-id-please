    {
      "name": "Two-phase commit - committed",
      "description": "A decision on an active shift: both databases change.",
      "item": [
        {
          "name": "Open a shift",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/session/sessions",
              "host": ["{{gatewayUrl}}"],
              "path": ["session", "sessions"]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"moderatorId\": \"{{playerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the shift is open', function () { pm.response.to.have.status(201); });",
                  "pm.expect(pm.response.json().status).to.eql('active');",
                  "pm.collectionVariables.set('sessionId', pm.response.json().sessionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the score before",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cache-Control",
                "value": "no-cache"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/session/sessions/{{sessionId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["session", "sessions", "{{sessionId}}"]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the shift is read', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('nothing is applied to a new shift', function () {",
                  "    pm.expect(body.decisionsApplied).to.eql(0);",
                  "});",
                  "pm.collectionVariables.set('scoreBefore', body.score);"
                ]
              }
            }
          ]
        },
        {
          "name": "Process an applicant",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/session/sessions/{{sessionId}}/process-applicant",
              "host": ["{{gatewayUrl}}"],
              "path": ["session", "sessions", "{{sessionId}}", "process-applicant"]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('an applicant is in front of the moderator', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().currentApplicantId).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('applicantA', pm.response.json().currentApplicantId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Decide - committed",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/moderation/moderation/decide",
              "host": ["{{gatewayUrl}}"],
              "path": ["moderation", "moderation", "decide"]
            },
            "description": "Moderation asks the Broker to run moderation.decision: Moderation records the decision, Session applies it to the score.",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sessionId\": \"{{sessionId}}\",\n    \"applicantId\": \"{{applicantA}}\",\n    \"decision\": \"reject\",\n    \"decidedBy\": \"{{playerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the decision is recorded', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('it names the transaction that recorded it', function () {",
                  "    pm.expect(body.transactionId).to.match(/^[0-9a-f-]{36}$/);",
                  "});",
                  "pm.test('the verdict is consistent', function () {",
                  "    pm.expect(body.correct).to.eql(body.decision === body.expectedDecision);",
                  "});",
                  "pm.collectionVariables.set('transactionId', body.transactionId);",
                  "pm.collectionVariables.set('decisionId', body.decisionId);",
                  "pm.collectionVariables.set('expectedDelta', body.correct ? 10 : -body.penalty);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the decision right away",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/moderation/moderation/{{decisionId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["moderation", "moderation", "{{decisionId}}"]
            },
            "description": "Moderation commits its own branch as soon as the outcome is known, so the decision is there at once."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the committed decision is there', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json().decisionId).to.eql(pm.collectionVariables.get('decisionId'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the score after",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cache-Control",
                "value": "no-cache"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/session/sessions/{{sessionId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["session", "sessions", "{{sessionId}}"]
            },
            "description": "Session's change lands in the coordinator's second phase, just after the decision was answered, so this re-reads for a few seconds until it does."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const tries = Number(pm.collectionVariables.get('pollTries') || 0);",
                  "if (!(body.decisionsApplied === 1) && tries < 20) {",
                  "    pm.collectionVariables.set('pollTries', tries + 1);",
                  "    setTimeout(function () {}, 250);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.set('pollTries', 0);",
                  "pm.test('Session applied the decision once', function () {",
                  "    pm.expect(body.decisionsApplied).to.eql(1);",
                  "});",
                  "pm.test('the score moved by the decision', function () {",
                  "    const expected = Number(pm.collectionVariables.get('scoreBefore')) + Number(pm.collectionVariables.get('expectedDelta'));",
                  "    pm.expect(body.score).to.eql(expected);",
                  "});",
                  "pm.collectionVariables.set('scoreAfter', body.score);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Two-phase commit - aborted",
      "description": "A decision on a shift that has ended: Session votes NO, so neither database changes.",
      "item": [
        {
          "name": "Process another applicant",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/session/sessions/{{sessionId}}/process-applicant",
              "host": ["{{gatewayUrl}}"],
              "path": ["session", "sessions", "{{sessionId}}", "process-applicant"]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a second applicant is in front of the moderator', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('applicantB', pm.response.json().currentApplicantId);"
                ]
              }
            }
          ]
        },
        {
          "name": "End the shift",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/session/sessions/{{sessionId}}/end",
              "host": ["{{gatewayUrl}}"],
              "path": ["session", "sessions", "{{sessionId}}", "end"]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('the shift is over', function () { pm.response.to.have.status(200); });"]
              }
            }
          ]
        },
        {
          "name": "Decide - aborted",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/moderation/moderation/decide",
              "host": ["{{gatewayUrl}}"],
              "path": ["moderation", "moderation", "decide"]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sessionId\": \"{{sessionId}}\",\n    \"applicantId\": \"{{applicantB}}\",\n    \"decision\": \"accept\",\n    \"decidedBy\": \"{{playerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the transaction is aborted', function () { pm.response.to.have.status(409); });",
                  "const error = pm.response.json().error;",
                  "pm.test('with the contract code', function () { pm.expect(error.code).to.eql('TX_ABORTED'); });",
                  "pm.test('every vote is in details, Session voting no', function () {",
                  "    const votes = Object.fromEntries(error.details.map(function (v) { return [v.service, v]; }));",
                  "    pm.expect(votes).to.have.all.keys('moderation-service', 'session-service');",
                  "    pm.expect(votes['session-service'].yes).to.eql(false);",
                  "    pm.expect(votes['session-service'].reason).to.match(/^CONFLICT: /);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "The aborted decision left no row",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/moderation/sessions/{{sessionId}}/decisions",
              "host": ["{{gatewayUrl}}"],
              "path": ["moderation", "sessions", "{{sessionId}}", "decisions"]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the shift still has one decision', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.count).to.eql(1);",
                  "    pm.expect(body.decisions[0].applicantId).to.eql(pm.collectionVariables.get('applicantA'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "The aborted decision left the score alone",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cache-Control",
                "value": "no-cache"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/session/sessions/{{sessionId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["session", "sessions", "{{sessionId}}"]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Session still applied only the first decision', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.decisionsApplied).to.eql(1);",
                  "    pm.expect(body.score).to.eql(Number(pm.collectionVariables.get('scoreAfter')));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Saga - completed",
      "description": "Applicant intake: Applicant creates the applicant, then Credential issues its credential.",
      "item": [
        {
          "name": "Start an intake",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/applicant/applicants/intake",
              "host": ["{{gatewayUrl}}"],
              "path": ["applicant", "applicants", "intake"]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"seed\": {{$randomInt}}\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the saga is started', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202]); });",
                  "const body = pm.response.json();",
                  "pm.test('it has an id and a state', function () {",
                  "    pm.expect(body.sagaId).to.be.a('string').and.not.empty;",
                  "    pm.expect(['running', 'completed']).to.include(body.state);",
                  "});",
                  "pm.collectionVariables.set('sagaId', body.sagaId);",
                  "pm.collectionVariables.set('sagaApplicantId', body.applicantId || '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for the saga to complete",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/applicant/applicants/intake/{{sagaId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["applicant", "applicants", "intake", "{{sagaId}}"]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const tries = Number(pm.collectionVariables.get('pollTries') || 0);",
                  "if (!(['completed', 'compensated', 'failed'].includes(body.state)) && tries < 40) {",
                  "    pm.collectionVariables.set('pollTries', tries + 1);",
                  "    setTimeout(function () {}, 250);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.set('pollTries', 0);",
                  "pm.test('the saga completed', function () { pm.expect(body.state).to.eql('completed'); });",
                  "pm.test('both steps are done', function () {",
                  "    pm.expect(body.steps.map(function (s) { return s.state; })).to.eql(['done', 'done']);",
                  "});",
                  "if (!pm.collectionVariables.get('sagaApplicantId') && body.context) {",
                  "    pm.collectionVariables.set('sagaApplicantId', body.context.applicantId);",
                  "}"
                ]
              }
            }
          ]
        },
