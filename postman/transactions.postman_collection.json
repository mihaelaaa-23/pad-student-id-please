                  "// stack defaults to false, where simulateFailAt is ignored and the saga completes. So this",
                  "// folder runs only when asked: newman ... --env-var testHooks=true",
                  "if (String(pm.environment.get('testHooks') || pm.collectionVariables.get('testHooks')) !== 'true') {",
                  "    console.log('Skipped: saga compensation needs ENABLE_TEST_HOOKS=true and --env-var testHooks=true');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('compensation deleted the applicant', function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        }
      ]
