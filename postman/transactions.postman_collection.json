    {
      "name": "Saga - compensated (needs testHooks=true)",
      "description": "The credential step is made to fail, so the saga undoes step 1. Needs Credential with ENABLE_TEST_HOOKS=true and newman --env-var testHooks=true; skipped otherwise.",
      "item": [
        {
          "name": "Start an intake that fails at Credential",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/applicant/applicants/intake",
              "host": ["{{gatewayUrl}}"],
              "path": ["applicant", "applicants", "intake"]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n    \"seed\": {{$randomInt}},\n    \"simulateFailAt\": \"credential-service\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Compensation only happens when Credential runs with ENABLE_TEST_HOOKS=true; the shared",
                  "// stack defaults to false, where simulateFailAt is ignored and the saga completes. So this",
                  "// folder runs only when asked: newman ... --env-var testHooks=true",
                  "if (String(pm.environment.get('testHooks') || pm.collectionVariables.get('testHooks')) !== 'true') {",
                  "    console.log('Skipped: saga compensation needs ENABLE_TEST_HOOKS=true and --env-var testHooks=true');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('the saga is started', function () { pm.expect(pm.response.code).to.be.oneOf([200, 202]); });",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('sagaId', body.sagaId);",
                  "pm.collectionVariables.set('sagaApplicantId', body.applicantId || '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Wait for the saga to compensate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/applicant/applicants/intake/{{sagaId}}",
              "host": ["{{gatewayUrl}}"],
              "path": ["applicant", "applicants", "intake", "{{sagaId}}"]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{serviceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Compensation only happens when Credential runs with ENABLE_TEST_HOOKS=true; the shared",
                  "// stack defaults to false, where simulateFailAt is ignored and the saga completes. So this",
                  "// folder runs only when asked: newman ... --env-var testHooks=true",
                  "if (String(pm.environment.get('testHooks') || pm.collectionVariables.get('testHooks')) !== 'true') {",
                  "    console.log('Skipped: saga compensation needs ENABLE_TEST_HOOKS=true and --env-var testHooks=true');",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const tries = Number(pm.collectionVariables.get('pollTries') || 0);",
                  "if (!(['completed', 'compensated', 'failed'].includes(body.state)) && tries < 40) {",
                  "    pm.collectionVariables.set('pollTries', tries + 1);",
                  "    setTimeout(function () {}, 250);",
                  "    postman.setNextRequest(pm.info.requestName);",
                  "    return;",
                  "}",
                  "pm.collectionVariables.set('pollTries', 0);",
                  "pm.test('the saga compensated', function () { pm.expect(body.state).to.eql('compensated'); });",
                  "pm.test('step 1 was undone and step 2 failed', function () {",
                  "    pm.expect(body.steps.map(function (s) { return s.state; })).to.eql(['compensated', 'failed']);",
                  "});",
                  "if (!pm.collectionVariables.get('sagaApplicantId') && body.context) {",
                  "    pm.collectionVariables.set('sagaApplicantId', body.context.applicantId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "The applicant is gone",
