{
  "info": {
    "_postman_id": "b1e1b2b0-4444-4a1a-9c1a-credential01",
    "name": "Credential Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3004" },
    { "key": "applicantId", "value": "" },
    { "key": "forgedApplicantId", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Credentials are keyed by applicantId, so a fixed id would return 409 on a",
              "// second run. Fresh ids per run keep the collection repeatable.",
              "const run = Date.now();",
              "pm.collectionVariables.set('applicantId', 'pm-' + run);",
              "pm.collectionVariables.set('forgedApplicantId', 'pm-forged-' + run);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('reports ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Issue Credential",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('returns the contract shape', function () {",
              "  pm.expect(json).to.have.all.keys('applicantId', 'studentIdCard', 'universityEmail', 'valid', 'issues');",
              "});",
              "pm.test('an honest credential is valid', function () {",
              "  pm.expect(json.valid).to.be.true;",
              "  pm.expect(json.issues).to.be.an('array').that.is.empty;",
              "});",
              "pm.test('does not expose internal fields', function () {",
              "  pm.expect(json).to.not.have.property('scenario');",
              "  pm.expect(json).to.not.have.property('signature');",
              "  pm.expect(json).to.not.have.property('applicantCore');",
              "});",
              "pm.test('issues the documents a student holds', function () {",
              "  pm.expect(json.studentIdCard).to.include('FCIM-234411');",
              "  pm.expect(json.universityEmail).to.eql('ana.rusu@utm.md');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"core\": {\n    \"name\": \"Ana Rusu\",\n    \"studentId\": \"FCIM-234411\",\n    \"major\": \"Robotics\",\n    \"year\": 2,\n    \"role\": \"student_faf\",\n    \"status\": \"active\"\n  },\n  \"seed\": 9\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/credentials/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Issue Credential - Duplicate",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 409', function () { pm.response.to.have.status(409); });",
              "pm.test('reports CONFLICT', function () { pm.expect(pm.response.json().error.code).to.eql('CONFLICT'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"core\": {\n    \"name\": \"Ana Rusu\",\n    \"studentId\": \"FCIM-234411\",\n    \"role\": \"student_faf\",\n    \"status\": \"active\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/credentials/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Issue Credential - Missing Applicant Core",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 422', function () { pm.response.to.have.status(422); });",
              "pm.test('uses the shared error shape', function () {",
              "  pm.expect(json.error.code).to.eql('VALIDATION_FAILED');",
              "});",
              "pm.test('names the missing field', function () {",
              "  const paths = json.error.details.map(function (d) { return d.path; });",
              "  pm.expect(paths).to.include('core');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": {
          "raw": "{{baseUrl}}/credentials/pm-no-core",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "pm-no-core"]
        }
      }
    },
    {
      "name": "Get Credential",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns the requested credential', function () {",
              "  pm.expect(json.applicantId).to.eql(pm.collectionVariables.get('applicantId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/credentials/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Get Credential - Unknown Applicant",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('reports NOT_FOUND', function () { pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/credentials/does-not-exist",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "does-not-exist"]
        }
      }
    },
    {
      "name": "Validate Credential",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns the contract shape', function () {",
              "  pm.expect(json).to.have.all.keys('applicantId', 'valid', 'issues');",
              "});",
              "pm.test('reports the credential as valid', function () {",
              "  pm.expect(json.valid).to.be.true;",
              "  pm.expect(json.issues).to.be.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/credentials/{{applicantId}}/validate",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "{{applicantId}}", "validate"]
        }
      }
    },
    {
      "name": "Issue Forged Credential",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "pm.test('detects the forgery and the malformed id', function () {",
              "  pm.expect(json.valid).to.be.false;",
              "  pm.expect(json.issues).to.include('FORGED_SIGNATURE');",
              "  pm.expect(json.issues).to.include('MALFORMED_STUDENT_ID');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"core\": {\n    \"name\": \"Vlad Gutu\",\n    \"studentId\": \"FCIM-X41234\",\n    \"role\": \"student_faf\",\n    \"status\": \"active\"\n  },\n  \"scenario\": \"fake_student_id\",\n  \"seed\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/credentials/{{forgedApplicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "{{forgedApplicantId}}"]
        }
      }
    },
    {
      "name": "List Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returns a page', function () {",
              "  pm.expect(json.items).to.be.an('array').that.is.not.empty;",
              "  pm.expect(json).to.have.property('nextCursor');",
              "});",
              "pm.test('every item carries the contract shape', function () {",
              "  json.items.forEach(function (item) {",
              "    pm.expect(item).to.have.all.keys('applicantId', 'studentIdCard', 'universityEmail', 'valid', 'issues');",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/credentials?limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["credentials"],
          "query": [{ "key": "limit", "value": "5" }]
        }
      }
    },
    {
      "name": "Patch Credential - Tampering Breaks The Signature",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('the edited document no longer verifies', function () {",
              "  pm.expect(json.valid).to.be.false;",
              "  pm.expect(json.issues).to.include('FORGED_SIGNATURE');",
              "  pm.expect(json.issues).to.include('INCONSISTENT_NAME');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"holderName\": \"Someone Else\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/credentials/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Patch Credential - Immutable Field",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', function () { pm.response.to.have.status(422); });",
              "pm.test('refuses to change the shared key', function () {",
              "  pm.expect(pm.response.json().error.message).to.include('immutable');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"studentId\": \"FCIM-999999\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/credentials/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Delete Credential",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('confirms the deletion', function () {",
              "  pm.expect(json.applicantId).to.eql(pm.collectionVariables.get('applicantId'));",
              "  pm.expect(json.deleted).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/credentials/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "{{applicantId}}"]
        }
      }
    },
    {
      "name": "Delete Credential - Already Deleted",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 404', function () { pm.response.to.have.status(404); });",
              "pm.test('reports NOT_FOUND', function () { pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/credentials/{{applicantId}}",
          "host": ["{{baseUrl}}"],
          "path": ["credentials", "{{applicantId}}"]
        }
      }
    }
  ]
}
