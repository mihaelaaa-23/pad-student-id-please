# Copy this file to .env and replace every placeholder before running docker compose.
# .env is gitignored; this file must never contain a real password.
#
#   cp .env.example .env
#
# Generate a strong value with:
#   python3 -c "import secrets; print(secrets.token_hex(16))"

# ---------- Gateway (Mihaela) ----------
# How long the Gateway waits for a service before answering 504 GATEWAY_TIMEOUT.
GATEWAY_UPSTREAM_TIMEOUT_MS=10000

# ---------- Authorization (Lab 2, grade 10) ----------
# Signs the login token in Player Service. At least 32 characters; the stack does not
# start without it. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# ---------- Player Service (Mihaela) ----------
PLAYER_DB_USER=player_user
PLAYER_DB_PASSWORD=replace-with-a-strong-password
PLAYER_DB_NAME=player_service_db
# Lab 2, grade 8 (timeout budget in the README): task timeout (504 TASK_TIMEOUT) and
# concurrent task limit (503 CONCURRENCY_LIMIT_REACHED).
PLAYER_TASK_TIMEOUT_MS=2000
PLAYER_MAX_CONCURRENT_TASKS=50

# ---------- Server Moderation Session Service (Mihaela) ----------
SESSION_DB_USER=session_user
SESSION_DB_PASSWORD=replace-with-a-strong-password
SESSION_DB_NAME=session_service_db
# Lab 2, grade 8 (timeout budget in the README): outgoing call timeout, task timeout
# (504 TASK_TIMEOUT) and concurrent task limit (503 CONCURRENCY_LIMIT_REACHED).
SESSION_HTTP_TIMEOUT_MS=4500
SESSION_TASK_TIMEOUT_MS=8000
SESSION_MAX_CONCURRENT_TASKS=50

# ---------- Applicant Service (Ciprian) ----------
APPLICANT_DB_USER=applicant_user
APPLICANT_DB_PASSWORD=replace-with-a-strong-password
APPLICANT_DB_NAME=applicant_service_db
# Share of generated applicants carrying false information, between 0 and 1.
APPLICANT_DECEPTIVE_RATE=0.35
# Lab 2, grade 8: a request still running after this many ms gets 504 TASK_TIMEOUT.
APPLICANT_TASK_TIMEOUT_MS=3000
# Outgoing call timeout to University Record (timeout budget in the README).
APPLICANT_HTTP_TIMEOUT_MS=2500
# Requests handled at once; the next one gets 503 CONCURRENCY_LIMIT_REACHED.
APPLICANT_MAX_CONCURRENT_TASKS=50

# ---------- Credential Service (Ciprian) ----------
CREDENTIAL_DB_USER=credential_user
CREDENTIAL_DB_PASSWORD=replace-with-a-strong-password
CREDENTIAL_DB_NAME=credential_service_db
# Not a connection variable: this is the HMAC secret the service signs and verifies
# credentials with. Without it the service falls back to a development secret, and a
# credential issued on one machine is reported as FORGED_SIGNATURE on another.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
CREDENTIAL_SIGNING_SECRET=replace-with-a-long-random-string
# Lab 2, grade 8: same meaning as for Applicant Service.
CREDENTIAL_TASK_TIMEOUT_MS=4000
# Outgoing call timeout to Applicant Service (timeout budget in the README).
CREDENTIAL_HTTP_TIMEOUT_MS=3500
CREDENTIAL_MAX_CONCURRENT_TASKS=50

# ---------- Server Rules Service (Ion) ----------
RULES_DB_USER=rules_user
RULES_DB_PASSWORD=replace-with-a-strong-password
RULES_DB_NAME=server_rules_service_db

# ---------- University Record Service (Ion) ----------
UNIVERSITY_RECORD_DB_USER=university_record_user
UNIVERSITY_RECORD_DB_PASSWORD=replace-with-a-strong-password
UNIVERSITY_RECORD_DB_NAME=university_records

# ---------- Moderation Service (Liviu) ----------
MODERATION_DB_USER=moderation_user
MODERATION_DB_PASSWORD=replace-with-a-strong-password
MODERATION_DB_NAME=moderation_service_db

# ---------- Discord DMs Service (Liviu) ----------
DISCORD_DMS_DB_USER=discord_dms_user
DISCORD_DMS_DB_PASSWORD=replace-with-a-strong-password
DISCORD_DMS_DB_NAME=discord_dms_service_db

# ---------- Demo only ----------
# true enables ?simulateDelayMs= on Applicant and Credential Service, used to show
# the 503/504 of grade 8. Keep false otherwise.
ENABLE_TEST_HOOKS=false
